rules_version = '2';

// 상하이 여행 사이트 보안 규칙
// · 로그인 화면 없음: 사이트가 자동으로 "익명 로그인"을 하고, 링크 속 여행 키를 아는 사람만 접근
// · 여행 목록 조회(list)는 막혀 있어서 키를 모르면 다른 여행을 찾을 수 없음
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function validKey(key) { return key.size() >= 16 && key.size() <= 40; }
    function smallDoc() { return request.resource.data.size() <= 40; }

    match /trips/{tripKey} {
      allow get: if signedIn() && validKey(tripKey);
      allow list: if false;
      allow create: if signedIn() && validKey(tripKey) && smallDoc()
                    && request.resource.data.members is list
                    && request.resource.data.members.size() <= 10;
      allow update: if signedIn() && smallDoc();
      allow delete: if false;

      match /{col}/{docId} {
        function allowedCol() {
          return col in ['places', 'stays', 'transports', 'schedule', 'checklist', 'expenses', 'links'];
        }
        allow read: if signedIn() && allowedCol()
                    && exists(/databases/$(database)/documents/trips/$(tripKey));
        allow create, update: if signedIn() && allowedCol() && smallDoc()
                    && existsAfter(/databases/$(database)/documents/trips/$(tripKey));
        allow delete: if signedIn() && allowedCol();
      }
    }
  }
}
